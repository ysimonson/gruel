{
  "name": "tree-sitter-gruel",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Gruel programming language",
  "main": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "gruel"
  ],
  "author": "The Gruel Project",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "tree-sitter build",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "tree-sitter": [
    {
      "scope": "source.gruel",
      "file-types": [
        "gruel"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^gruel$"
    }
  ]
}
